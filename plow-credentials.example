# Place Hunt Agent Credentials
#
# To run this agent:
# 1. Sign up / log in to Plow with `plow-agents login` (or via api.plow.co)
# 2. Mint or get credentials for your phone line
# 3. Copy this file to `plow-credentials`:
#      cp plow-credentials.example plow-credentials
# 4. Fill in your tokens below, then run:
#      docker compose up -d

PLOW_API_BASE=https://api.plow.co
PLOW_AGENT_TOKEN=

# Agent Index Leaderboard (https://aiworthusing.com/agent-index)
# Sets your unique listing slug on the leaderboard.
# The built-in agent-index service registers and reports token usage automatically.
AGENT_ID=place-hunt
AGENT_NAME=Place Hunt
AGENT_BLURB=Search and map places for groups, homes, camping spots, party parks, and restaurants

# Plow Latch (MCP tools to drive browser & store on your Mac)
# Minted from the Mac running Plow Latch:
DOMO_DEVICE_UID=
DOMO_MCP_TOKEN=
